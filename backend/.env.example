# Application
ENVIRONMENT=development
DEBUG=true
FRONTEND_URL=http://localhost:3000
SECRET_KEY=your-secret-key-change-in-production

# Database (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./proready.db
# For PostgreSQL: DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/proready

# AI/LLM Configuration
# Supports OpenAI, DeepInfra, or any OpenAI-compatible API
OPENAI_API_KEY=your-deepinfra-api-key
OPENAI_API_BASE=https://api.deepinfra.com/v1/openai
OPENAI_LLM_MODEL=moonshotai/kimi-k2.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Authentication
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Stripe (optional for testing)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email (optional for testing)
RESEND_API_KEY=re_...

# AWS S3 (optional for testing)
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
S3_BUCKET_NAME=proreadyengineer-uploads

# SignRequest (optional for testing)
SIGNREQUEST_API_KEY=...
