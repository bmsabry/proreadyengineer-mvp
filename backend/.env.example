# =============================================================================
# ProReadyEngineer MVP - Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME=ProReadyEngineer API
VERSION=0.1.0
API_V1_STR=/api/v1

# Secret key for JWT signing - generate with: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-change-this-in-production

# -----------------------------------------------------------------------------
# Database (PostgreSQL with pgvector)
# -----------------------------------------------------------------------------
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=proready_user
POSTGRES_PASSWORD=your-secure-password
POSTGRES_DB=proready_engineer

# Full async URL (used by SQLAlchemy)
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://proready_user:your-secure-password@localhost:5432/proready_engineer

# Sync URL for migrations (Alembic)
DATABASE_URL_SYNC=postgresql://proready_user:your-secure-password@localhost:5432/proready_engineer

# -----------------------------------------------------------------------------
# Redis (Celery / Caching)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# -----------------------------------------------------------------------------
# AWS S3 (File Storage)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=proready-engineer-uploads
S3_PRESIGNED_URL_EXPIRE_SECONDS=3600

# -----------------------------------------------------------------------------
# Stripe Payments
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# -----------------------------------------------------------------------------
# PayPal / Braintree
# -----------------------------------------------------------------------------
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-secret
BRAINTREE_MERCHANT_ID=
BRAINTREE_PUBLIC_KEY=
BRAINTREE_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# SignRequest (Document Signing)
# -----------------------------------------------------------------------------
SIGNREQUEST_API_KEY=your-signrequest-api-key
SIGNREQUEST_SUBDOMAIN=your-subdomain
SIGNREQUEST_WEBHOOK_SECRET=your-webhook-secret

# -----------------------------------------------------------------------------
# Email (Resend / SendGrid)
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_...
SENDGRID_API_KEY=SG...
EMAIL_FROM=noreply@proreadyengineer.com
EMAIL_FROM_NAME=ProReadyEngineer

# -----------------------------------------------------------------------------
# OpenAI (Embeddings & LLM)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_LLM_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Search & Quotas
# -----------------------------------------------------------------------------
ANONYMOUS_SEARCH_LIMIT_PER_MONTH=3
REGISTERED_SEARCH_LIMIT_PER_MONTH=10
SEARCH_TIER_1_LIMIT=100
SEARCH_TIER_1_PRICE=1000
SEARCH_TIER_2_LIMIT=200
SEARCH_TIER_2_PRICE=2000
RFQ_UNLOCK_PRICE=1000
NDA_FEE_PRICE=500
AD_SUBSCRIPTION_PRICE=5000

# -----------------------------------------------------------------------------
# RFQ Settings
# -----------------------------------------------------------------------------
RFQ_MAX_QUOTES=5
RFQ_DISPATCH_BATCH_SIZE=5
RFQ_DISPATCH_BATCH_INTERVAL_HOURS=24
