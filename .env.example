# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/proreadyengineer

# Redis
REDIS_URL=redis://localhost:6379/0

# Security (generate a strong random key)
SECRET_KEY=your-super-secret-key-here-min-32-chars-long

# Frontend URL
FRONTEND_URL=https://proreadyengineer-web.onrender.com
ALLOWED_ORIGINS=https://proreadyengineer-web.onrender.com

# OpenAI (for embeddings and search)
OPENAI_API_KEY=sk-your-openai-api-key

# Stripe (for payments)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# AWS S3 (for file storage)
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_S3_BUCKET=proreadyengineer-uploads
AWS_REGION=us-east-1

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@proreadyengineer.com

# Document Signing (SignRequest)
SIGNREQUEST_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SIGNREQUEST_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# PayPal (optional)
PAYPAL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYPAL_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYPAL_WEBHOOK_ID=xxxxxxxxxxxxxxxx
